    plt.figure(figsize=(8, 5))
    plt.plot(log_xi_fes, S_fes, 'ro', markersize=8, label='Datos DMRG ($g=1.250$)')
    x_fit = np.linspace(min(log_xi_fes)-0.1, max(log_xi_fes)+0.1, 100)
